# Stickies and presence (optional). Create a Supabase project, run
# supabase/schema.sql in its SQL editor, then copy these from
# Project Settings → API. The Supabase integration for Vercel sets the same
# values as NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# which work too. Without them, `astro dev` uses a local stand-in and
# production builds hide the features.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
