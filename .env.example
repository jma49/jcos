# Stickies and presence (optional). Create a Supabase project, run
# supabase/schema.sql in its SQL editor, then copy these from
# Project Settings → API. The Supabase integration for Vercel sets the same
# values as NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# which work too. Without them, `astro dev` uses a local stand-in and
# production builds hide the features.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Photos (optional). An Unsplash Access Key (unsplash.com/oauth/applications)
# lets the build use the official API for Jincheng's latest photos; without
# it the build keeps the snapshot in src/data/photos.json. Set it in Vercel
# and as a GitHub Actions secret too.
UNSPLASH_ACCESS_KEY=

# Server-side secrets never go here or in Vercel: the Soapbox bot's
# Telegram token and the account-recovery function's RESEND_API_KEY are
# Supabase Edge Function secrets (`supabase secrets set`).
