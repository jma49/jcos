---
import { content, profile, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="hairline mt-24 py-10">
  <div
    class="shell flex flex-col gap-3 text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {profile.name[lang]} · {t.footer.built}</p>
    <a
      href="https://github.com/jma49/Jincheng-Protafolio"
      target="_blank"
      rel="noopener"
      class="transition-colors hover:text-dim">{t.footer.source}</a
    >
  </div>
</footer>
