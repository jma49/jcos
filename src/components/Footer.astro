---
import { content, profile, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="meta mt-16 flex gap-4 border-t border-line pt-4">
  <span>© {year} {profile.name[lang]}</span>
  <a
    href="https://github.com/jma49/jmos"
    target="_blank"
    rel="noopener"
    class="transition-colors hover:text-ink">{t.footer.source}</a
  >
</footer>
