---
interface Props {
  email: string;
  copyLabel: string;
  copiedLabel: string;
}

const { email, copyLabel, copiedLabel } = Astro.props;
---

<button
  type="button"
  data-copy-email={email}
  data-copied-label={copiedLabel}
  aria-live="polite"
  class="meta ml-2 cursor-pointer text-[13px] transition-colors hover:text-ink"
>
  {copyLabel}
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    const label = button.textContent?.trim() ?? '';
    let timer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
      } catch {
        // Clipboard unavailable (insecure context, denied permission). The
        // mailto link next to this button still works.
        return;
      }
      button.textContent = button.dataset.copiedLabel ?? label;
      clearTimeout(timer);
      timer = setTimeout(() => (button.textContent = label), 2000);
    });
  });
</script>
