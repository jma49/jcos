---
import { Picture } from 'astro:assets';
import { content, type Lang } from '../i18n/content';
import { formatMonth, getProjects, projectHref } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const projects = await getProjects(lang);
---

{
  projects.length > 0 && (
    <section aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="heading mb-5">
        {t.projects.title}
      </h2>
      <ul class="project-grid grid gap-x-5 gap-y-8 sm:grid-cols-2">
        {projects.map((project) => (
          <li>
            <a href={projectHref(lang, project.slug)} class="project-card block">
              <div class="project-cover aspect-[16/10] overflow-hidden rounded-[10px] border border-line bg-surface">
                {project.data.cover ? (
                  <Picture
                    src={project.data.cover}
                    alt={`${t.projects.preview} ${project.data.title}`}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[320, 640, 960]}
                    sizes="(min-width: 640px) 290px, calc(100vw - 2.5rem)"
                    class="size-full object-cover object-top"
                  />
                ) : (
                  <span class="grid size-full place-items-center px-6 text-center text-lg font-semibold text-faint">
                    {project.data.title}
                  </span>
                )}
              </div>
              <div class="mt-3 flex items-baseline justify-between gap-3">
                <span class="project-title font-semibold">{project.data.title}</span>
                <span class="meta shrink-0">
                  {project.data.status === 'live'
                    ? formatMonth(lang, project.data.date)
                    : t.projects.status[project.data.status]}
                </span>
              </div>
              <p class="mt-1 text-[0.95rem] leading-snug text-dim">{project.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .project-card {
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .project-cover {
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-cover :global(img) {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-title {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.3s ease;
  }

  /* Hover (or keyboard focus): lift the card, zoom the preview, underline the
     title, and dim the other cards. */
  .project-card:is(:hover, :focus-visible) {
    transform: translateY(-3px);
  }

  .project-card:is(:hover, :focus-visible) .project-cover {
    border-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
    box-shadow: 0 12px 28px -14px color-mix(in srgb, var(--color-ink) 35%, transparent);
  }

  .project-card:is(:hover, :focus-visible) .project-cover :global(img) {
    transform: scale(1.04);
  }

  .project-card:is(:hover, :focus-visible) .project-title {
    text-decoration-color: currentColor;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-grid:has(.project-card:hover) .project-card:not(:hover) {
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-cover :global(img) {
      transition: none;
    }

    .project-card:is(:hover, :focus-visible) {
      transform: none;
    }

    .project-card:is(:hover, :focus-visible) .project-cover :global(img) {
      transform: none;
    }
  }
</style>
