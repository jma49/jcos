---
import SectionHeading from './SectionHeading.astro';
import { content, profile, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const isZh = lang === 'zh';
---

<section id="about" class="shell scroll-mt-24 pt-24 sm:pt-32">
  <SectionHeading index="03" title={t.about.title} />

  <div class="mt-12 grid gap-14 lg:grid-cols-[1fr_18rem] lg:gap-16">
    <div class="reveal max-w-2xl space-y-5">
      {
        t.about.paragraphs.map((paragraph) => (
          <p
            class:list={[
              'text-dim',
              isZh
                ? 'text-[0.9375rem] leading-[1.9]'
                : 'text-[0.9375rem] leading-[1.8]'
            ]}
          >
            {paragraph}
          </p>
        ))
      }
    </div>

    <aside class="reveal" style="transition-delay:100ms">
      <img
        src="/portrait.jpg"
        alt={profile.name[lang]}
        width="900"
        height="1125"
        loading="lazy"
        decoding="async"
        class="aspect-4/5 w-full max-w-[15rem] rounded-2xl border border-line object-cover saturate-[0.9] transition-all duration-500 hover:saturate-100 lg:max-w-none"
      />

      <h3 class="label mt-10">{t.education.title}</h3>
      <ul class="mt-4 space-y-5">
        {
          t.education.items.map((item) => (
            <li>
              <p class="text-sm font-medium text-ink">{item.school}</p>
              <p class="mt-0.5 text-[0.8125rem] text-dim">{item.degree}</p>
              <p class="mt-1 font-mono text-[0.6875rem] text-faint">
                {item.period} · {item.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>
