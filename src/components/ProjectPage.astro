---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import ThemeToggle from './ThemeToggle.astro';
import { content, profile } from '../content/site';
import { formatMonth, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const t = content;
const { Content } = await render(project);
const { title, description, date, status, stack, repo, demo, cover } = project.data;

const home = '/';

const meta = [formatMonth(date), t.projects.status[status], stack.join(', ')].filter(Boolean);
---

<Layout
  path={`/projects/${project.slug}/`}
  title={`${title} — ${profile.name}`}
  description={description}
>
  <article class="project">
    <header class="meta project-header">
      <a href={home} aria-label={t.projects.back} class="nav-link">
        ← {profile.name}
      </a>
      <div class="project-nav">
        <a href={`/?open=${project.slug}`} class="nav-link">Open in JM/OS</a>
        <ThemeToggle />
      </div>
    </header>

    <h1 class="project-title">
      {title}
    </h1>
    <p class="project-description">{description}</p>
    <p class="meta project-meta">{meta.join(' · ')}</p>

    {
      (demo || repo) && (
        <p class="project-links">
          {demo && (
            <a href={demo} target="_blank" rel="noopener" class="link">
              {t.projects.visit}
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noopener" class="link">
              {t.projects.source}
            </a>
          )}
        </p>
      )
    }

    {
      cover && (
        <Picture
          src={cover}
          alt={`${t.projects.preview} ${title}`}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[600, 1200]}
          sizes="(min-width: 640px) 600px, calc(100vw - 2.5rem)"
          loading="eager"
          class="project-cover"
        />
      )
    }

    <div class="prose project-body">
      <Content />
    </div>

    <Footer />
  </article>
</Layout>
