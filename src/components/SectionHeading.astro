---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}

const { index, title, subtitle } = Astro.props;
---

<div class="reveal">
  <div class="flex items-baseline gap-3">
    <span class="label">{index}</span>
    <span class="h-px flex-1 bg-line-soft"></span>
  </div>
  <h2 class="mt-5 text-2xl font-semibold tracking-tight sm:text-3xl">
    {title}
  </h2>
  {subtitle && <p class="mt-3 max-w-xl text-sm text-faint">{subtitle}</p>}
</div>
