---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section aria-labelledby="work-heading">
  <h2 id="work-heading" class="heading mb-4">{t.work.title}</h2>

  <ol>
    {
      t.jobs.map((job) => (
        <li class="border-b border-line py-4">
          <div class="grid grid-cols-1 items-baseline gap-x-5 sm:grid-cols-[minmax(0,1fr)_auto]">
            <h3>
              <span class="font-semibold">{job.company}</span>
              <span class="text-dim"> · {job.role}</span>
            </h3>
            <span class="meta whitespace-nowrap">{job.period}</span>
          </div>

          <p class="mt-1 text-dim">{job.summary}</p>

          <details class="disclosure mt-2">
            <summary class="meta text-[13px] transition-colors hover:text-dim">
              {t.ui.details}
            </summary>
            <ul class="mt-3 list-[square] space-y-2 pl-5 text-[0.95rem] text-dim marker:text-faint">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ol>
</section>
