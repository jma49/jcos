---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const separator = lang === 'zh' ? '、' : ', ';
---

<section aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="heading mb-4">{t.skills.title}</h2>

  <dl>
    {
      t.skills.groups.map((group) => (
        <div class="grid gap-x-5 border-b border-line py-2.5 sm:grid-cols-[9rem_minmax(0,1fr)]">
          <dt class="font-semibold">{group.name}</dt>
          <dd class="text-dim">{group.items.join(separator)}</dd>
        </div>
      ))
    }
  </dl>
</section>
