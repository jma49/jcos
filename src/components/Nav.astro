---
import { content, profile, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const otherHref = lang === 'en' ? '/zh/' : '/';

const links = [
  { href: '#work', label: t.nav.work },
  { href: '#skills', label: t.nav.skills },
  { href: '#about', label: t.nav.about },
  { href: '#contact', label: t.nav.contact }
];
---

<header
  class="sticky top-0 z-50 border-b border-line-soft bg-bg/72 backdrop-blur-xl backdrop-saturate-150"
>
  <nav class="shell flex h-16 items-center justify-between gap-4">
    <a href={lang === 'en' ? '/' : '/zh/'} class="group flex items-center gap-3">
      <span
        class="grid size-9 place-items-center rounded-lg border border-line bg-raised font-mono text-[0.8rem] font-medium text-ink transition-colors group-hover:border-accent/50 group-hover:text-accent-soft"
        >JM</span
      >
      <span class="flex flex-col leading-tight">
        <span class="text-sm font-medium">{profile.name[lang]}</span>
        <span class="label hidden text-[0.625rem] sm:block">{t.hero.eyebrow}</span>
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm text-dim transition-colors hover:bg-raised hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={otherHref}
        aria-label={t.nav.switchLabel}
        class="rounded-md border border-line px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-dim transition-colors hover:border-accent/50 hover:text-accent-soft"
        >{t.nav.switchTo}</a
      >

      <a
        href={profile.resume}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-ink px-3 py-1.5 text-xs font-semibold whitespace-nowrap text-bg transition-opacity hover:opacity-85"
        >{t.nav.resume}</a
      >
    </div>
  </nav>
</header>
