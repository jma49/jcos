// Biome formats the code (JS, TS, JSX, JSON, CSS): `npm run format`, and
// CI fails on anything left unformatted (`npm run format:check`). Linting
// stays with ESLint (eslint.config.js), so Biome's linter and assists are
// off. The settings are the ones the code was written in by hand: two
// spaces, single quotes (double in JSX), semicolons, no trailing commas,
// and a 160-column line, the width that changed the fewest lines.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Generated by supabase/tests/run.sh and formatted there by oxfmt;
      // the database job fails when it differs from what is committed.
      "!src/lib/database.types.ts",
      // Data, not code: snapshots the scripts write and lists of pictures.
      "!src/data/**/*.json",
      // Biome reads only an Astro file's frontmatter, not its markup.
      "!**/*.astro"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteProperties": "asNeeded"
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "css": { "formatter": { "enabled": true, "quoteStyle": "single" } }
}
